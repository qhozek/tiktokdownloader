async def command_ttenable(ctx: Any, invocation: Any) -> Any:
    _ = invocation
    await _set_enabled(ctx, invocation, "auto_tt", True, "Автоскачивание TikTok")
async def command_ttdisable(ctx: Any, invocation: Any) -> Any:
    _ = invocation
    await _set_enabled(ctx, invocation, "auto_tt", False, "Автоскачивание TikTok")
async def command_ttchats(ctx: Any, invocation: Any) -> Any:
    _ = invocation
    await _show_enabled(ctx, "auto_tt", "Авто-TikTok:", "Автоскачивание TikTok нигде не включено.")
async def command_ytenable(ctx: Any, invocation: Any) -> Any:
    _ = invocation
    await _set_enabled(ctx, invocation, "auto_yt", True, "Автоскачивание YouTube")
async def command_ytdisable(ctx: Any, invocation: Any) -> Any:
    _ = invocation
    await _set_enabled(ctx, invocation, "auto_yt", False, "Автоскачивание YouTube")
