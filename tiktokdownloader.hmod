async def command_allenable(ctx: Any, invocation: Any) -> Any:
    _ = invocation
    cid = _chat_id(ctx, invocation)
    if not cid:
        await ctx.respond("<b>Не удалось определить чат.</b>")
        return
    topic = _topic_id(ctx, invocation)
    pair = [int(cid), int(topic) if isinstance(topic, int) and topic > 0 else None]
    for k in ("auto_tt", "auto_yt", "auto_x", "auto_ig"):
        pairs = _load_targets(ctx, k)
        if not _target_on(pairs, cid, topic):
            pairs.append(pair)
            _save_targets(ctx, k, pairs)
    await ctx.respond("<b>Автоскачивание всех сервисов включено в этом чате.</b>")
async def command_alldisable(ctx: Any, invocation: Any) -> Any:
    _ = invocation
    cid = _chat_id(ctx, invocation)
    if not cid:
        await ctx.respond("<b>Не удалось определить чат.</b>")
        return
    topic = _topic_id(ctx, invocation)
    for k in ("auto_tt", "auto_yt", "auto_x", "auto_ig"):
        pairs = _load_targets(ctx, k)
        kept: Any = []
        for pair in pairs:
            try:
                pc, pt = int(pair[0]), pair[1]
                pt = int(pt) if isinstance(pt, int) and pt > 0 else None
            except Exception:
                continue
            if pc != int(cid):
                kept.append([pc, pt])
                continue
            if topic is not None and pt is not None and pt != int(topic):
                kept.append([pc, pt])
        _save_targets(ctx, k, kept)
    await ctx.respond("<b>Все автоскачивания выключены в этом чате.</b>")
async def command_allchats(ctx: Any, invocation: Any) -> Any:
    _ = invocation
    await _show_all_targets(ctx)
