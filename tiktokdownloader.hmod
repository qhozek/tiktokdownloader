    await _show_enabled(ctx, "auto_x", "Авто-X:", "Автоскачивание X нигде не включено.")
async def command_igenable(ctx: Any, invocation: Any) -> Any:
    _ = invocation
    await _set_enabled(ctx, invocation, "auto_ig", True, "Автоскачивание Instagram")
async def command_igdisable(ctx: Any, invocation: Any) -> Any:
    _ = invocation
    await _set_enabled(ctx, invocation, "auto_ig", False, "Автоскачивание Instagram")
async def command_igchats(ctx: Any, invocation: Any) -> Any:
    _ = invocation
    await _show_enabled(ctx, "auto_ig", "Авто-Instagram:", "Автоскачивание Instagram нигде не включено.")
async def command_allenable(ctx: Any, invocation: Any) -> Any:
    cid = _chat_id(ctx, invocation)
    if not cid:
        await ctx.respond("<b>Не удалось определить чат.</b>")
        return
    for k in ("auto_tt", "auto_yt", "auto_x", "auto_ig"):
        ids = _load_ids(ctx, k)
        if int(cid) not in ids:
            ids.append(int(cid))
            _save_ids(ctx, k, ids)
    await ctx.respond("<b>Автоскачивание всех сервисов включено в этом чате.</b>")
async def command_alldisable(ctx: Any, invocation: Any) -> Any:
    cid = _chat_id(ctx, invocation)
    if not cid:
        await ctx.respond("<b>Не удалось определить чат.</b>")
        return
    for k in ("auto_tt", "auto_yt", "auto_x", "auto_ig"):
        ids = [x for x in _load_ids(ctx, k) if x != int(cid)]
        _save_ids(ctx, k, ids)
    await ctx.respond("<b>Все автоскачивания выключены в этом чате.</b>")
async def command_allchats(ctx: Any, invocation: Any) -> Any:
    _ = invocation
    lines: Any = ["<b>Все включённые автозагрузки:</b>"]
    any_on = False
    for k, t in (("auto_tt", "TikTok"), ("auto_yt", "YouTube"), ("auto_x", "X"), ("auto_ig", "Instagram")):
        ids = _load_ids(ctx, k)
        if ids:
            any_on = True
            lines.append("<b>" + _esc(t) + ":</b> " + ", ".join("<code>" + str(c) + "</code>" for c in sorted(set(ids))))
    if not any_on:
        await ctx.respond("<b>Автоскачивание нигде не включено.</b>")
        return
    await ctx.respond("\n".join(lines))
async def watcher_autodl(ctx: Any, message: Any) -> Any:
    try:
        cid = _chat_id(ctx, message)
        if not cid:
            return
        text = _msg_text(message)
        mid: Any = None
        try:
            getm: Any = getattr(message, "get", None)
            if callable(getm):
                mid = getm("id") or getm("message_id")
            else:
                mid = getattr(message, "id", None) or getattr(message, "message_id", None)
        except Exception:
            mid = None
        if not text and cid and isinstance(mid, int):
            try:
                fetched = await ctx.msg(cid, int(mid))
                text = _msg_text(fetched)
            except Exception:
                return
        if not text:
            cctx_mid: Any = None
            try:
                cctx_mid = getattr(ctx, "message_id", None)
                cctx_cid = getattr(ctx, "chat_id", None)
                if cctx_cid and cctx_mid and not text:
                    fetched = await ctx.msg(cctx_cid, int(cctx_mid))
                    text = _msg_text(fetched)
                    if not cid and cctx_cid:
                        cid = int(cctx_cid)
            except Exception:
                return
        if not text:
            return
        t = text.strip()
        if t and t[0] in SKIP_PREFIXES:
            first = t[1:].strip().split()[0].lower() if t[1:].strip() else ""
            if first in SKIP_FIRST:
                return
        svc, url = _find_any(t)
        if not url:
            return
        key = {"tt": "auto_tt", "yt": "auto_yt", "x": "auto_x", "ig": "auto_ig"}.get(svc)
        if not key:
            return
        if not _enabled(ctx, key, cid):
            return
        await _download_one(ctx, url, False, svc)
    except Exception:
        return
