HOTARU = {
    "id": "tiktokdownloader",
    "version": "1.0.2",
    "commands": ["tt", "ttsound", "yt", "x", "ig", "ttenable", "ttdisable", "ttchats", "ytenable", "ytdisable", "ytchats", "xenable", "xdisable", "xchats", "igenable", "igdisable", "igchats", "allenable", "alldisable", "allchats"],
    "capabilities": ["state", "files", "shell"],
    "watchers": ["autodl"],
    "aliases": {"twitter": "x", "inst": "ig", "instagram": "ig"},
    "lexicon": {
        "en": {"description": "TikTok / YouTube / X / Instagram downloader (yt-dlp via shell)", "commands": {"tt": {"description": "<link> - download TikTok"}, "ttsound": {"description": "<link> - TikTok audio only"}, "yt": {"description": "<link> - download YouTube"}, "x": {"description": "<link> - download X/Twitter"}, "ig": {"description": "<link> - download Instagram"}}},
        "ru": {"description": "Скачивание TikTok / YouTube / X / Instagram (yt-dlp через shell)", "commands": {"tt": {"description": "<ссылка> - скачать TikTok"}, "ttsound": {"description": "<ссылка> - только звук TikTok"}, "yt": {"description": "<ссылка> - скачать YouTube"}, "x": {"description": "<ссылка> - скачать X/Twitter"}, "ig": {"description": "<ссылка> - скачать Instagram"}}},
    },
}
import re
import html
from typing import Any
from urllib.parse import urlparse, unquote
URL_RE = re.compile(r"https?://[^\s<>]+", re.IGNORECASE)
SKIP_PREFIXES = (".", "/", "!")
SKIP_FIRST = {"tt", "ttsound", "yt", "x", "twitter", "ig", "inst", "instagram", "ttenable", "ttdisable", "ytenable", "ytdisable", "xenable", "xdisable", "igenable", "igdisable", "allenable", "alldisable"}
VIDEO_EXTS = (".mp4", ".mkv", ".webm", ".mov", ".m4v", ".avi", ".3gp", ".ts", ".jpg", ".jpeg", ".png", ".webp")
AUDIO_EXTS = (".mp3", ".m4a", ".ogg", ".opus", ".wav", ".flac")
def _prefix(ctx: Any) -> Any:
    try:
        rt = getattr(ctx, "runtime", None)
        cfg = getattr(rt, "config", None)
        p = getattr(cfg, "prefix", None)
        if isinstance(p, str) and p:
            return p
    except Exception:
        pass
    return "."
def _esc(v: Any) -> Any:
    return html.escape(str(v), quote=False)
def _shq(s: Any) -> Any:
    return "'" + str(s).replace("'", "'\"'\"'") + "'"
def _is_tiktok_url(url: Any) -> Any:
    try:
        p = urlparse(str(url))
        host = (p.hostname or "").lower().rstrip(".")
    except Exception:
        return False
    if p.scheme not in ("http", "https"):
        return False
    if not (host == "tiktok.com" or host.endswith(".tiktok.com")):
        return False
    path = p.path or ""
    dec = unquote(path).strip()
    q = p.query or ""
    if host in ("vm.tiktok.com", "vt.tiktok.com", "v.tiktok.com"):
        return bool(re.match(r"^/[A-Za-z0-9_-]{3,}", path))
    if re.match(r"^/t/[A-Za-z0-9_-]{3,}", path):
        return True
    if re.search(r"/(?:video|photo|photos|v|embed)/(\d{5,})", dec, re.IGNORECASE):
        return True
    if re.search(r"/@[^/]+/(?:video|photo|photos)/(\d{5,})", dec, re.IGNORECASE):
        return True
    if re.search(r"/share/(?:video|photo)/(\d{5,})", dec, re.IGNORECASE):
        return True
    if re.search(r"/music/[^/?#]{3,}", dec, re.IGNORECASE):
        return True
    if re.search(r"(?:item_id|itemId|aweme_id|share_item_id|modal_id)=\d{5,}", q):
        return True
    if re.search(r"(?<!\d)\d{15,24}(?!\d)", dec):
        return True
    return False
def _is_youtube_url(url: Any) -> Any:
    try:
        p = urlparse(str(url))
        host = (p.hostname or "").lower().rstrip(".")
    except Exception:
        return False
    if p.scheme not in ("http", "https"):
        return False
    if host not in ("youtube.com", "www.youtube.com", "m.youtube.com", "music.youtube.com", "youtu.be", "www.youtu.be"):
        return False
    path = p.path or ""
    q = p.query or ""
    if host in ("youtu.be", "www.youtu.be"):
        return bool(re.match(r"^/[A-Za-z0-9_-]{5,}", path))
    if re.search(r"(?:^|[?&])v=[A-Za-z0-9_-]{5,}", q):
        return True
    if re.search(r"/(?:shorts|live|embed|v|clip)/[A-Za-z0-9_-]{5,}", path, re.IGNORECASE):
        return True
    return False
def _is_x_url(url: Any) -> Any:
    try:
        p = urlparse(str(url))
        host = (p.hostname or "").lower().rstrip(".")
    except Exception:
        return False
    if p.scheme not in ("http", "https"):
        return False
    if host not in ("x.com", "www.x.com", "mobile.x.com", "twitter.com", "www.twitter.com", "mobile.twitter.com"):
        return False
    return re.search(r"/[^/]+/status/\d+", p.path or "", re.IGNORECASE) is not None
def _is_instagram_url(url: Any) -> Any:
    try:
        p = urlparse(str(url))
        host = (p.hostname or "").lower().rstrip(".")
    except Exception:
        return False
    if p.scheme not in ("http", "https"):
        return False
    if host not in ("instagram.com", "www.instagram.com", "m.instagram.com", "ddinstagram.com", "www.ddinstagram.com"):
        if host not in ("instagram.com", "www.instagram.com", "m.instagram.com", "mobile.instagram.com", "instagr.am", "www.instagr.am"):
            return False
    return re.search(r"/(?:share/)?(?:p|reel|reels|tv)/([A-Za-z0-9_-]+)", p.path or "", re.IGNORECASE) is not None
def _first_url(text: Any, check: Any) -> Any:
    if not text:
        return None
    for m in URL_RE.finditer(text):
        c = m.group(0).rstrip(".,;:!?)]}>'\"")
        try:
            if check(c):
                return c
        except Exception:
            continue
    return None
def _find_any(text: Any) -> Any:
    for svc, fn in (("tt", _is_tiktok_url), ("yt", _is_youtube_url), ("x", _is_x_url), ("ig", _is_instagram_url)):
        u = _first_url(text, fn)
        if u:
            return svc, u
    return None, None
async def _reply_text(ctx: Any) -> Any:
    try:
        t = await ctx.reply_text()
        if isinstance(t, str) and t.strip():
            return t.strip()
    except Exception:
        pass
    return ""
async def _input_url(ctx: Any, invocation: Any) -> Any:
    parts: Any = []
    try:
        args = getattr(invocation, "args", ()) or ()
        if args:
            parts.append(" ".join(str(a) for a in args))
    except Exception:
        pass
    rt = await _reply_text(ctx)
    if rt:
        parts.append(rt)
    text = " ".join(parts).strip()
    if not text:
        return None
    m = URL_RE.search(text)
    if not m:
        return None
    return m.group(0).rstrip(".,;:!?)]}>'\"")
def _chat_id(ctx: Any, invocation: Any = None, message: Any = None) -> Any:
    for obj in (invocation, ctx, message):
        if obj is None:
            continue
        get = getattr(obj, "get", None)
        if callable(get):
            for k in ("chat_id", "peer_id", "chat"):
                v = get(k)
                if isinstance(v, int) and v:
                    return v
            continue
        for k in ("chat_id", "peer_id"):
            try:
                v = getattr(obj, k, None)
                if callable(v):
                    continue
                if isinstance(v, int) and v:
                    return v
            except Exception:
                continue
    return 0
def _msg_text(message: Any) -> Any:
    if message is None:
        return ""
    get = getattr(message, "get", None)
    if callable(get):
        for k in ("message", "text", "caption", "raw_text"):
            v = get(k)
            if isinstance(v, str) and v.strip():
                return v
        return ""
    for k in ("text", "raw_text", "message", "caption"):
        try:
            v = getattr(message, k, None)
            if callable(v):
                continue
            if isinstance(v, str) and v.strip():
                return v
        except Exception:
            continue
    return ""
def _load_ids(ctx: Any, key: Any) -> Any:
    try:
        v = ctx.state.get(key, [])
    except Exception:
        return []
    if not isinstance(v, list):
        return []
    items: Any = v
    out: Any = []
    for x in items:
        try:
            out.append(int(x))
        except Exception:
            continue
    return out
def _save_ids(ctx: Any, key: Any, ids: Any) -> Any:
    try:
        ctx.state.set(key, [int(x) for x in ids])
    except Exception:
        pass
def _enabled(ctx: Any, key: Any, cid: Any) -> Any:
    try:
        return int(cid) in _load_ids(ctx, key)
    except Exception:
        return False
async def _set_enabled(ctx: Any, invocation: Any, key: Any, on: Any, label: Any) -> Any:
    cid = _chat_id(ctx, invocation)
    if not cid:
        await ctx.respond("<b>Не удалось определить чат.</b> Вызови команду из нужного чата.")
        return
    ids = _load_ids(ctx, key)
    has = int(cid) in ids
    if on and has:
        await ctx.respond("<b>" + _esc(label) + " уже включено в этом чате.</b>")
        return
    if not on and not has:
        await ctx.respond("<b>" + _esc(label) + " в этом чате не включено.</b>")
        return
    if on:
        ids.append(int(cid))
    else:
        ids = [x for x in ids if x != int(cid)]
    _save_ids(ctx, key, ids)
    verb = "включено" if on else "выключено"
    await ctx.respond("<b>" + _esc(label) + " " + verb + " в этом чате.</b>")
async def _show_enabled(ctx: Any, key: Any, title: Any, empty: Any) -> Any:
    ids = _load_ids(ctx, key)
    if not ids:
        await ctx.respond("<b>" + _esc(empty) + "</b>")
        return
    lines: Any = ["<b>" + _esc(title) + "</b>"]
    for c in sorted(set(ids)):
        lines.append("• <code>" + str(c) + "</code>")
    await ctx.respond("\n".join(lines))
async def _shell(ctx: Any, command: Any, timeout: Any = 115) -> Any:
    try:
        timeout = max(1, min(int(timeout), 120))
    except Exception:
        timeout = 115
    return await ctx.cap("shell", {"command": command[:4000], "timeout": timeout})
def _pick_file(output: Any, audio_only: Any) -> Any:
    exts = AUDIO_EXTS if audio_only else (VIDEO_EXTS + AUDIO_EXTS)
    if not output:
        return None
    cands: Any = []
    for line in str(output).splitlines():
        t = line.strip().strip("'\"")
        if not t:
            continue
        low = t.lower()
        for e in exts:
            if low.endswith(e):
                cands.append(t.split()[-1].strip("'\""))
                break
    if cands:
        return cands[-1].split("/")[-1].split("\\")[-1]
    return None
async def _download_one(ctx: Any, url: Any, audio_only: Any, service: Any) -> Any:
    url = str(url or "")[:1500]
    if audio_only:
        fmt = '"bestaudio/best" -x --audio-format mp3'
        tpl = "au_%(id)s.%(ext)s"
        doing = "<b>Извлекаю звук…</b>"
    else:
        fmt = '"bv*[ext=mp4]+ba[ext=m4a]/b[ext=mp4]/bv*+ba/b" --merge-output-format mp4'
        tpl = "dl_%(id)s.%(ext)s"
        doing = "<b>Скачиваю…</b>"
    await ctx.respond(doing)
    cmd = "command -v yt-dlp >/dev/null 2>&1 || { echo NO_YTDLP; exit 3; }; " + ("command -v ffmpeg >/dev/null 2>&1 || { echo NO_FFMPEG; }; " if audio_only else "") + "yt-dlp --no-playlist --no-warnings --socket-timeout 20 -f " + fmt + " -o '" + tpl + "' --print after_move:filepath " + _shq(url) + " 2>&1 | tail -n 30"
    try:
        res = await _shell(ctx, cmd, 115)
    except Exception as e:
        await ctx.respond("<b>Shell недоступен:</b> <code>" + _esc(type(e).__name__ + ": " + str(e)[:300]) + "</code>")
        return
    try:
        rc = res.get("returncode", -1)
        out = res.get("output", "")
        cwd = res.get("cwd", "")
    except Exception:
        rc, out, cwd = -1, "", ""
    if "NO_YTDLP" in out or rc == 3:
        await ctx.respond("<b>На сервере нет yt-dlp.</b> Установи yt-dlp и ffmpeg, затем повтори.")
        return
    fname = _pick_file(out, audio_only)
    if not fname:
        tail = _esc(str(out)[-1200:])
        await ctx.respond("<b>Не удалось скачать.</b>\n<blockquote expandable>" + tail + "</blockquote>")
        return
    try:
        names = await ctx.cap("files", {"op": "list"})
    except Exception:
        names = []
    if isinstance(names, list) and fname not in names:
        base = fname
        found: Any = None
        for n in names:
            if isinstance(n, str) and n == base:
                found = n
                break
        if found is None and names:
            for n in names:
                if isinstance(n, str) and (n.startswith("dl_") or n.startswith("au_")):
                    found = n
        if found is not None:
            fname = found
    label = {"tt": "TikTok", "yt": "YouTube", "x": "X/Twitter", "ig": "Instagram"}.get(service, "Видео")
    cap = "<b>" + _esc(label) + "</b>\n<a href=\"" + _esc(url) + "\">Открыть оригинал</a>"
    path = (str(cwd).rstrip("/") + "/" + fname) if cwd and not fname.startswith("/") else fname
    try:
        await ctx.send_file(path, cap)
    except Exception as e:
        msg = str(e)[:500]
        if "sandbox respond media" in msg or "files capability" in msg:
            await ctx.respond("<b>Файл скачан на сервер:</b> <code>" + _esc(fname) + "</code>\nЯдро Hotaru (sandbox) сейчас блокирует отправку медиа через respond — нужен фикс ядра или запуск как системный модуль (constellations/).\n<blockquote expandable>" + _esc(msg) + "</blockquote>")
        else:
            await ctx.respond("<b>Скачано, но не отправлено:</b> <code>" + _esc(fname) + "</code>\n<blockquote expandable>" + _esc(msg) + "</blockquote>")
async def command_tt(ctx: Any, invocation: Any) -> Any:
    p = _prefix(ctx)
    url = await _input_url(ctx, invocation)
    if not url:
        await ctx.respond("<b>Использование:</b> <code>" + _esc(p) + "tt &lt;ссылка&gt;</code>")
        return
    if not _is_tiktok_url(url):
        await ctx.respond("<b>Не удалось распознать ссылку на TikTok.</b>")
        return
    await _download_one(ctx, url, False, "tt")
async def command_ttsound(ctx: Any, invocation: Any) -> Any:
    p = _prefix(ctx)
    url = await _input_url(ctx, invocation)
    if not url:
        await ctx.respond("<b>Использование:</b> <code>" + _esc(p) + "ttsound &lt;ссылка&gt;</code>")
        return
    if not _is_tiktok_url(url):
        await ctx.respond("<b>Не удалось распознать ссылку на TikTok.</b>")
        return
    await _download_one(ctx, url, True, "tt")
