    update = False
    args: Any = ()
    try:
        args = getattr(invocation, "args", ())
    except Exception:
        args = ()
    try:
        update = any(str(a).casefold() == "update" for a in args)
    except Exception:
        update = False
    await _ytdlp_flow(ctx, invocation, update)
