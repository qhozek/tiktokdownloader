async def command_autoconfig(ctx: Any, invocation: Any) -> Any:
    _ = invocation
    await _autoconfigure(ctx, invocation)
async def watcher_autodl(ctx: Any, message: Any) -> Any:
    try:
        cid = _chat_id(ctx, message)
        if not cid:
            return
        text = _msg_text(message)
        mid: Any = None
        try:
            getm: Any = getattr(message, "get", None)
            if callable(getm):
                mid = getm("id") or getm("message_id")
            else:
                mid = getattr(message, "id", None) or getattr(message, "message_id", None)
        except Exception:
            mid = None
        if not text and cid and isinstance(mid, int):
            try:
                fetched = await ctx.msg(cid, int(mid))
                text = _msg_text(fetched)
            except Exception:
                return
        if not text:
            cctx_mid: Any = None
            try:
                cctx_mid = getattr(ctx, "message_id", None)
                cctx_cid = getattr(ctx, "chat_id", None)
                if cctx_cid and cctx_mid and not text:
                    fetched = await ctx.msg(cctx_cid, int(cctx_mid))
                    text = _msg_text(fetched)
                    if not cid and cctx_cid:
                        cid = int(cctx_cid)
            except Exception:
                return
        if not text:
            return
        t = text.strip()
        if t and t[0] in SKIP_PREFIXES:
            first = t[1:].strip().split()[0].lower() if t[1:].strip() else ""
            if first in SKIP_FIRST:
                return
        svc, url = _find_any(t)
        if not url:
            return
        key = SVC_KEY.get(svc, "")
        if not key:
            return
        topic = _topic_id(ctx, message)
        if not _target_on(_load_targets(ctx, key), cid, topic):
            return
        if svc == SVC_TT:
            await _tiktok_flow(ctx, url, None, False, True)
        elif svc == SVC_YT:
            await _generic_flow(ctx, url, None, SVC_YT, True)
        elif svc == SVC_X:
            await _generic_flow(ctx, url, None, SVC_X, True)
        elif svc == SVC_IG:
            await _generic_flow(ctx, url, None, SVC_IG, True)
    except Exception:
        return
